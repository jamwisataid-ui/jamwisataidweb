# Neon runtime connection (gunakan pooled endpoint di production)
DATABASE_URL="postgresql://user:password@host-pooler/db?sslmode=require"

# Alias Vercel Postgres/Neon juga didukung bila DATABASE_URL tidak tersedia
POSTGRES_URL=""

# Direct Neon connection khusus Drizzle migration
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# UploadThing (gambar paket, galeri, artikel, dan destinasi)
UPLOADTHING_TOKEN=""

# Resend (opsional saat development, diperlukan untuk reset password)
RESEND_API_KEY=""
EMAIL_FROM="Jam Wisata <noreply@jamwisata.id>"

# Cloudflare R2 private (dokumen jamaah dan PDF transaksi)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
R2_BUCKET_NAME="jamwisata-jamaah-private"

# Kunci 32-byte base64 untuk field PII bila enkripsi aplikasi diaktifkan
PII_ENCRYPTION_KEY=""
