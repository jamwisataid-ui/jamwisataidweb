[Unit]
Description=Jam Wisata PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/jamwisata/current
ExecStart=/usr/bin/bash /opt/jamwisata/current/deploy/jamwisata/scripts/backup-postgres.sh
Nice=10
IOSchedulingClass=idle
