{
  "expo": {
    "name": "Jam Wisata",
    "slug": "matt",
    "icon": "./assets/icon/icon.png",
    "scheme": "jamwisata",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d18e9906-12f6-4cd1-96c5-9804d510a282",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class livekit.org.webrtc.** { *; }\n-keep class livekit.org.jni_zero.** { *; }\n-keep class org.jni_zero.** { *; }\n-keep class com.livekit.** { *; }\n-keep class com.oney.WebRTCModule.** { *; }\n-keepclasseswithmembernames class * { native <methods>; }"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06152B",
          "image": "./assets/splash/logo-emblem.png",
          "imageWidth": 132,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "informasi-perjalanan"
        }
      ],
      "expo-status-bar"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jamwisata.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Mikrofon digunakan oleh muthowif untuk menyiarkan panduan ibadah secara langsung."
      }
    },
    "android": {
      "package": "com.jamwisata.mobile",
      "versionCode": 7,
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-icon.png",
        "backgroundColor": "#06152B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d18e9906-12f6-4cd1-96c5-9804d510a282"
      }
    },
    "owner": "matthmd28s-team"
  }
}
