{
  "expo": {
    "name": "Jam Wisata",
    "slug": "jam-wisata",
    "scheme": "jamwisata",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-splash-screen", { "backgroundColor": "#06152B", "image": "./assets/splash/logo-emblem.png", "imageWidth": 132, "resizeMode": "contain" }],
      ["expo-notifications", { "defaultChannel": "informasi-perjalanan" }]
    ],
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.jamwisata.mobile" },
    "android": { "package": "com.jamwisata.mobile", "adaptiveIcon": { "backgroundColor": "#06152B" } },
    "web": { "bundler": "metro", "output": "single" },
    "extra": { "router": { "origin": false } }
  }
}
